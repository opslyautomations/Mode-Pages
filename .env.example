# Inbound webhook (GoHighLevel / Zapier / Make). Required in production.
LEAD_WEBHOOK_URL=

# Secret used to sign lead IDs so /book and Calendly only open for qualified leads.
# Generate with: openssl rand -hex 32
LEAD_SIGNING_SECRET=

# Salt for hashing visitor IPs stored with consent records.
IP_HASH_SALT=

# Date eligibility thresholds were last confirmed with Mode (e.g. 2026-11-04).
ELIGIBILITY_LAST_VERIFIED=

# Optional: Resend for the follow-up email and the webhook-failure fallback email.
RESEND_API_KEY=
RESEND_FROM=

# Optional: Upstash Redis REST for distributed rate limiting (otherwise in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional analytics (set one). No-op if both empty.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Chat assistant: GoHighLevel Agent Studio managed agent (server-side only, never exposed to the browser).
GHL_API_TOKEN=
GHL_AGENT_ID=
GHL_LOCATION_ID=
# Add this line to the GHL agent's instructions so the site knows when to open the booking calendar:
#   "When the visitor meets the program's criteria and you would invite them to book a call, end your reply with [[BOOK]] on its own line. Never use [[BOOK]] otherwise."
